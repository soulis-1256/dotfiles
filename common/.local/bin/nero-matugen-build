#!/usr/bin/env bash
# Rebuild Nero-Matugen cursor theme from live matugen primary (or $1 hex).
# Usage: nero-matugen-build [#rrggbb] [size]
set -euo pipefail

COLOR="${1:-}"

if [[ -n "${2:-}" ]]; then
  SIZE="$2"
else
  BASE_SIZE=$(python3 -c "
import json
try:
    d = json.load(open('$HOME/.config/DankMaterialShell/settings.json'))
    cs = d.get('cursorSettings', {})
    val = cs.get('size') if isinstance(cs, dict) else None
    print(val or d.get('cursorSize') or 24)
except Exception:
    print(24)
" 2>/dev/null || echo 24)
  # Nero's diamond reads smaller than a normal pointer. +8 selects the
  # 32px bitmap when Dank's size is 24. Keep this in sync with
  # SettingsData.effectiveCursorSize.
  SIZE=$(( BASE_SIZE + 8 ))
fi

if [[ -n "$COLOR" ]]; then
  python3 ~/.local/share/nero-matugen/build.py \
    ~/.local/share/nero-matugen/frames ~/.icons/Nero-Matugen "$COLOR"
else
  python3 ~/.local/share/nero-matugen/build.py \
    ~/.local/share/nero-matugen/frames ~/.icons/Nero-Matugen
fi

# Hyprland caches cursor textures: same name+size won't refresh from disk,
# so bounce through another theme to force a reload.
hyprctl setcursor default "$SIZE" >/dev/null 2>&1 || true
hyprctl setcursor Nero-Matugen "$SIZE" 2>/dev/null || true
echo "Nero-Matugen rebuilt (size ${SIZE} = default + 8). Pick Nero-Matugen in DMS Settings > Cursor to persist."
