#!/usr/bin/env bash
set -euo pipefail

PATCH_DIR="${HOME}/.config/dms/patches"
if [[ ! -d "$PATCH_DIR" ]]; then
    PATCH_DIR="${HOME}/dotfiles/common/.config/dms/patches"
fi

if [[ -d "$PATCH_DIR" ]]; then
    PATCH_DIR="$(readlink -f "$PATCH_DIR")"
else
    exit 0
fi

UID_NUM="$(id -u)"
BASE_DIR="/run/user/${UID_NUM}/dms-shell"

if [[ ! -d "$BASE_DIR" ]]; then
    exit 0
fi

applied_count=0

for shell_dir in "$BASE_DIR"/*; do
    if [[ ! -d "$shell_dir" ]]; then
        continue
    fi

    while IFS= read -r patch_file; do
        rel_path="${patch_file#$PATCH_DIR/}"
        target_file="$shell_dir/$rel_path"
        target_dir="$(dirname "$target_file")"

        if [[ -d "$target_dir" ]]; then
            if cmp -s "$patch_file" "$target_file" 2>/dev/null; then
                continue
            fi
            chmod u+w "$target_dir" "$target_file" 2>/dev/null || true
            cp -f "$patch_file" "$target_file"
            ((applied_count++)) || true
        fi
    done < <(find -L "$PATCH_DIR" -type f)
done

# If any patch was applied or updated, signal DMS to reload Quickshell
if (( applied_count > 0 )); then
    dms_pid="${MAINPID:-$(pgrep -u "$UID_NUM" -x dms 2>/dev/null | head -n1 || true)}"
    if [[ -n "$dms_pid" ]]; then
        kill -USR1 "$dms_pid" 2>/dev/null || true
    fi
fi
