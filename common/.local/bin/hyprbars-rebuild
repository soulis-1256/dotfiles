#!/usr/bin/env bash
# Rebuild the forked hyprbars plugin against the installed Hyprland headers.
#
# Hyprland plugins are version-locked: the plugin API version changes between
# releases (0.56 => "0.1", 0.57 => "0.2") and every render/decoration signature
# is allowed to move. A .so built for the previous release refuses to load, so
# the bar silently disappears after a system upgrade.
#
# Triggered by hyprbars-rebuild.path when /usr/share/pkgconfig/hyprland.pc is
# rewritten by a package upgrade. Safe to run at any time: it is a no-op unless
# the installed version differs from the last successful build.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES="$(git -C "$(dirname "$SELF")" rev-parse --show-toplevel 2>/dev/null || true)"
SRC="${HYPRBARS_SRC:-${DOTFILES:-$HOME/dotfiles}/common/.config/hypr/plugins/hyprbars}"
DEST="$HOME/.local/lib/hyprland"
SO="$DEST/hyprbars.so"
STAMP="$DEST/.hyprbars-version"

log() { printf '[hyprbars-rebuild] %s\n' "$*" >&2; }

# Don't touch a working .so before 0.57 headers exist: the ported source only
# builds against the 0.57 API.
if ! grep -qs 'CRenderContext' /usr/include/hyprland/src/render/pass/PassElement.hpp; then
    log "installed headers are pre-0.57, nothing to do"
    exit 0
fi

VERSION="$(pkg-config --modversion hyprland 2>/dev/null || echo unknown)"
if [[ -f "$SO" && -f "$STAMP" && "$(cat "$STAMP")" == "$VERSION" ]]; then
    log "hyprbars.so already built for Hyprland $VERSION"
    exit 0
fi

log "building hyprbars for Hyprland $VERSION"
mkdir -p "$DEST"
backup=""
if [[ -f "$SO" ]]; then
    backup="$SO.$(cat "$STAMP" 2>/dev/null || echo old)"
    cp -f "$SO" "$backup" || true
fi

if ! make -C "$SRC" clean all; then
    log "build failed; keeping the previous binary"
    exit 1
fi

install -m 755 "$SRC/hyprbars.so" "$SO.tmp"
mv -f "$SO.tmp" "$SO"
printf '%s\n' "$VERSION" > "$STAMP"
log "installed $SO for Hyprland $VERSION"

# Never unload the plugin from a live session: PLUGIN_EXIT leaves every existing
# bar decoration with function pointers into the .so that is about to be
# dlclose()d, so the next frame can take the whole compositor down. Hyprland has
# no safe hot-swap for plugins that add window decorations; a fresh binary is
# only picked up when the session restarts.
if command -v hyprctl >/dev/null 2>&1; then
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"
    if [[ -z "$sig" && -d "$runtime/hypr" ]]; then
        sig="$(ls -1dt "$runtime"/hypr/*/ 2>/dev/null | head -n1 | xargs -r basename || true)"
    fi
    if [[ -n "$sig" ]] && XDG_RUNTIME_DIR="$runtime" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl version >/dev/null 2>&1; then
        log "a Hyprland session is running; log out and back in (or reboot) to load the new binary"
    fi
fi
