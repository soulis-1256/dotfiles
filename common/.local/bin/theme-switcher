#!/usr/bin/env bash
#
# Switch between modular Hyprland / DankMaterialShell themes.
# Themes live in the dotfiles repo under themes/<name>/.
#

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/../../.." && pwd)"
# Overridable for tests via THEME_SWITCHER_THEMES_DIR.
THEMES_DIR="${THEME_SWITCHER_THEMES_DIR:-${DOTFILES_DIR}/themes}"

CURRENT_THEME_FILE="${HOME}/.config/.current_theme"
HYPR_THEME_SYMLINK="${HOME}/.config/hypr/theme.lua"
DMS_CONFIG_DIR="${HOME}/.config/DankMaterialShell"
MANAGED_PLUGINS=(win10Start win10Clock win10Media win10Tray win11Start win11Clock win11Media win11Tray win11Snap)

BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

get_current_theme() {
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        cat "$CURRENT_THEME_FILE"
    else
        echo "default"
    fi
}

list_themes() {
    echo -e "${BOLD}${BLUE}=== Available Desktop Themes ===${NC}"
    local current
    current="$(get_current_theme)"

    for theme_dir in "${THEMES_DIR}"/*; do
        [[ -d "$theme_dir" ]] || continue
        # Skip shared/lib directories that are not switchable themes.
        [[ -f "${theme_dir}/metadata.json" || -f "${theme_dir}/theme.lua" ]] || continue
        local theme_id name desc
        theme_id="$(basename "$theme_dir")"
        name="$theme_id"
        desc=""
        if [[ -f "${theme_dir}/metadata.json" ]]; then
            name="$(python3 -c "import json; print(json.load(open('${theme_dir}/metadata.json')).get('name', '${theme_id}'))" 2>/dev/null || echo "$theme_id")"
            desc="$(python3 -c "import json; print(json.load(open('${theme_dir}/metadata.json')).get('description', ''))" 2>/dev/null || echo "")"
        fi
        if [[ "$theme_id" == "$current" ]]; then
            echo -e "  ${GREEN}* ${BOLD}${theme_id}${NC} (${name}) ${CYAN}[ACTIVE]${NC}"
        else
            echo -e "    ${BOLD}${theme_id}${NC} (${name})"
        fi
        if [[ -n "$desc" ]]; then
            echo -e "      ${desc}"
        fi
    done
    echo ""
}

sync_plugins() {
    local theme_path="$1"
    mkdir -p "${DMS_CONFIG_DIR}/plugins"

    local plugin
    for plugin in "${MANAGED_PLUGINS[@]}"; do
        rm -f "${DMS_CONFIG_DIR}/plugins/${plugin}"
    done

    if [[ -d "${theme_path}/plugins" ]]; then
        local src
        for src in "${theme_path}/plugins"/*; do
            [[ -d "$src" ]] || continue
            ln -sfn "$src" "${DMS_CONFIG_DIR}/plugins/$(basename "$src")"
            echo -e "  ${GREEN}✓${NC} Installed plugin $(basename "$src")"
        done
    fi

    # Snap layouts are theme-agnostic: always install the shared plugin.
    local shared_plugins="${THEMES_DIR}/shared/plugins"
    if [[ -d "$shared_plugins" ]]; then
        local src
        for src in "${shared_plugins}"/*; do
            [[ -d "$src" ]] || continue
            ln -sfn "$src" "${DMS_CONFIG_DIR}/plugins/$(basename "$src")"
            echo -e "  ${GREEN}✓${NC} Installed shared plugin $(basename "$src")"
        done
    fi

    if [[ -f "${theme_path}/plugin_settings.json" ]]; then
        python3 - "$theme_path/plugin_settings.json" "${DMS_CONFIG_DIR}/plugin_settings.json" <<'PY'
import json, sys
from pathlib import Path

incoming = json.loads(Path(sys.argv[1]).read_text())
out = Path(sys.argv[2])
existing = {}
if out.exists():
    try:
        existing = json.loads(out.read_text() or "{}")
    except json.JSONDecodeError:
        existing = {}
if not isinstance(existing, dict):
    existing = {}
if not isinstance(incoming, dict):
    incoming = {}

# Theme files seed first-run defaults. User pin/folder/grid state lives in
# the live file and must survive reapply / theme switches.
# `enabled` is theme-owned so plugins turn on/off with the theme.
THEME_OWNED_KEYS = {"enabled"}

for plugin, pdata in incoming.items():
    if plugin not in existing or not isinstance(existing.get(plugin), dict) or not isinstance(pdata, dict):
        existing[plugin] = pdata
        continue
    for key, value in pdata.items():
        if key in THEME_OWNED_KEYS or key not in existing[plugin]:
            existing[plugin][key] = value

out.write_text(json.dumps(existing, indent=2) + "\n")
PY
        echo -e "  ${GREEN}✓${NC} Updated plugin settings"
    fi
}

apply_dms_settings() {
    local theme_settings="$1"
    local target="$2"
    local reset_flag="${3:-0}"
    local current
    current="$(get_current_theme)"
    local state_dir="${DMS_CONFIG_DIR}/theme-state"
    mkdir -p "$state_dir"
    python3 - "$theme_settings" "${DMS_CONFIG_DIR}/settings.json" "$HOME" "$state_dir" "$current" "$target" "$reset_flag" <<'PY'
import json, sys
from pathlib import Path

theme_path = Path(sys.argv[1])
dest_path = Path(sys.argv[2])
home = sys.argv[3]
state_dir = Path(sys.argv[4])
current = sys.argv[5]
target = sys.argv[6]
reset = sys.argv[7] == "1"

# Machine/greeter settings that follow the live machine config across themes
PRESERVE_PREFIXES = ("greeter",)
PRESERVE_KEYS = {
    "runUserMatugenTemplates",
    "matugenTargetMonitor",
}


def load_obj(path):
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text() or "{}")
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def fill_missing(base, incoming):
    if not isinstance(base, dict) or not isinstance(incoming, dict):
        return base
    for key, value in incoming.items():
        if key not in base:
            base[key] = value
        elif isinstance(base[key], dict) and isinstance(value, dict):
            fill_missing(base[key], value)
    return base


def overlay_preserved(base, live):
    if not isinstance(live, dict):
        return base
    for key, value in live.items():
        if key in PRESERVE_KEYS or key.startswith(PRESERVE_PREFIXES):
            base[key] = value
    return base


def walk_widgets(obj, fn):
    if isinstance(obj, dict):
        fn(obj)
        for value in obj.values():
            walk_widgets(value, fn)
    elif isinstance(obj, list):
        for value in obj:
            walk_widgets(value, fn)


def theme_pill_order(theme):
    found = []

    def grab(widget):
        if widget.get("id") == "controlCenterButton" and widget.get("controlCenterGroupOrder") and not found:
            found.append(list(widget["controlCenterGroupOrder"]))

    walk_widgets(theme, grab)
    return found[0] if found else None


def apply_theme_control_center(base, theme):
    """Stale theme-state snapshots predate the pill reorder and still
    ship a darkMode tile. Theme chrome owns both of those."""
    if not isinstance(base, dict) or not isinstance(theme, dict):
        return base

    order = theme_pill_order(theme)
    if order:
        def fill_order(widget):
            if widget.get("id") == "controlCenterButton":
                widget["controlCenterGroupOrder"] = list(order)

        walk_widgets(base, fill_order)

    theme_tiles = theme.get("controlCenterWidgets")
    base_tiles = base.get("controlCenterWidgets")
    if isinstance(theme_tiles, list) and isinstance(base_tiles, list):
        theme_ids = {tile.get("id") for tile in theme_tiles if isinstance(tile, dict)}
        if "floatingMode" in theme_ids:
            for tile in base_tiles:
                if isinstance(tile, dict) and tile.get("id") == "darkMode":
                    tile["id"] = "floatingMode"
    return base


live = load_obj(dest_path)
theme = json.loads(theme_path.read_text().replace("/home/soulis", home))
if not isinstance(theme, dict):
    theme = {}

state_dir.mkdir(parents=True, exist_ok=True)
current_state = state_dir / f"{current}.json"
target_state = state_dir / f"{target}.json"

# Snapshot the theme we are leaving so bar/layout tweaks come back later.
if current != target and live:
    current_state.write_text(json.dumps(live, indent=2) + "\n")

if reset:
    base = theme
    if target_state.exists():
        target_state.unlink()
elif current == target and live:
    # Reapply: keep the live config the user has been editing.
    base = fill_missing(live, theme)
elif target_state.exists():
    # Returning to a theme: restore last snapshot, pick up new theme keys.
    base = fill_missing(load_obj(target_state), theme)
else:
    base = theme

base = overlay_preserved(base, live)
base = apply_theme_control_center(base, theme)
# Theme files must stay theme-owned. A leftover settings.json symlink would
# write the merged live config back into themes/<theme>/dms-settings.json.
if dest_path.is_symlink():
    dest_path.unlink()
dest_path.write_text(json.dumps(base, indent=2) + "\n")
PY
}

apply_theme() {
    local target="$1"
    local reset_flag="${2:-0}"
    local theme_path="${THEMES_DIR}/${target}"

    if [[ ! -d "$theme_path" || ( ! -f "${theme_path}/metadata.json" && ! -f "${theme_path}/theme.lua" ) ]]; then
        echo -e "${RED}Error: Theme '${target}' not found in ${THEMES_DIR}.${NC}"
        echo ""
        list_themes
        exit 1
    fi

    echo -e "${BOLD}${CYAN}Switching theme to: ${BOLD}${target}...${NC}"

    local saved_float=""
    local saved_ws=""
    local saved_layout=""
    local saved_layout_mode=""
    if [[ -f "${HOME}/.cache/hypr_layout_state.json" ]]; then
        saved_layout="$(cat "${HOME}/.cache/hypr_layout_state.json" 2>/dev/null || true)"
    fi
    if [[ -f "${HOME}/.cache/hypr_layout_mode" ]]; then
        saved_layout_mode="$(cat "${HOME}/.cache/hypr_layout_mode" 2>/dev/null || true)"
    elif [[ -f /tmp/hypr_layout_mode ]]; then
        saved_layout_mode="$(cat /tmp/hypr_layout_mode 2>/dev/null || true)"
    fi
    if [[ -f "${HOME}/.cache/hypr_floating_mode" ]]; then
        saved_float="$(head -c 1 "${HOME}/.cache/hypr_floating_mode" 2>/dev/null || true)"
    elif [[ -f /tmp/hypr_floating_mode ]]; then
        saved_float="$(head -c 1 /tmp/hypr_floating_mode 2>/dev/null || true)"
    fi
    if [[ -f "${HOME}/.cache/hypr_floating_workspaces.json" ]]; then
        saved_ws="$(cat "${HOME}/.cache/hypr_floating_workspaces.json" 2>/dev/null || true)"
    elif [[ -f /tmp/hypr_floating_workspaces.json ]]; then
        saved_ws="$(cat /tmp/hypr_floating_workspaces.json 2>/dev/null || true)"
    fi

    # Stop DMS first so it does not hot-reload a partial settings write
    # (that retriggers greeter auto-login sync).
    if command -v dms &>/dev/null; then
        dms kill &>/dev/null || systemctl --user stop dms.service &>/dev/null || true
    fi

    if [[ -f "${theme_path}/theme.lua" ]]; then
        mkdir -p "$(dirname "$HYPR_THEME_SYMLINK")"
        ln -sfn "${theme_path}/theme.lua" "$HYPR_THEME_SYMLINK"
        echo -e "  ${GREEN}✓${NC} Linked Hyprland theme overrides"
    fi

    if [[ -f "${theme_path}/dms-settings.json" ]]; then
        mkdir -p "${DMS_CONFIG_DIR}"
        apply_dms_settings "${theme_path}/dms-settings.json" "$target" "$reset_flag"
        if [[ "$reset_flag" == "1" ]]; then
            echo -e "  ${GREEN}✓${NC} Applied DankMaterialShell settings (reset to theme defaults)"
        else
            echo -e "  ${GREEN}✓${NC} Applied DankMaterialShell settings"
        fi
    fi

    # Snap bridge is shared by every theme.
    if [[ ! -f "${HOME}/.local/lib/hyprland/hypr-snap-bridge-v3.so" ]]; then
        local plugin_src="${DOTFILES_DIR}/common/.config/hypr/plugins/hypr-snap-bridge"
        if [[ -d "$plugin_src" ]] && command -v pkg-config &>/dev/null && pkg-config --exists hyprland 2>/dev/null; then
            echo -e "  ${CYAN}Building Hyprland snap plugin...${NC}"
            make -C "$plugin_src" install &>/dev/null || true
        fi
    fi

    sync_plugins "$theme_path"

    if command -v dms &>/dev/null; then
        systemctl --user start dms.service &>/dev/null || dms restart &>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Restarted DankMaterialShell"
    fi

    # Reload Hypr after DMS so generated layout.lua / colors.lua are picked up.
    if command -v hyprctl &>/dev/null && hyprctl activewindow &>/dev/null; then
        hyprctl reload &>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Reloaded Hyprland configuration"
        # Theme chrome must not clobber layout state or Super+Z / Super+X floating state.
        if [[ -n "$saved_layout" ]]; then
            printf '%s\n' "$saved_layout" > "${HOME}/.cache/hypr_layout_state.json"
        fi
        if [[ -n "$saved_layout_mode" ]]; then
            printf '%s\n' "$saved_layout_mode" > "${HOME}/.cache/hypr_layout_mode"
            printf '%s\n' "$saved_layout_mode" > /tmp/hypr_layout_mode
        fi
        if [[ -n "$saved_float" ]]; then
            printf '%s\n' "$saved_float" > "${HOME}/.cache/hypr_floating_mode"
            printf '%s\n' "$saved_float" > /tmp/hypr_floating_mode
        fi
        if [[ -n "$saved_ws" ]]; then
            printf '%s\n' "$saved_ws" > "${HOME}/.cache/hypr_floating_workspaces.json"
            printf '%s\n' "$saved_ws" > /tmp/hypr_floating_workspaces.json
        fi
        hyprctl eval "_G.floating_mode_restore_from_cache()" &>/dev/null || true
    fi

    echo "$target" > "$CURRENT_THEME_FILE"
    echo -e "${BOLD}${GREEN}Successfully activated theme: ${target}${NC}"
}

# Promote curated live DMS settings back into a theme's dms-settings.json
# so GUI tweaks get versioned. Dry run by default; --apply writes.
# Only SYNC_BACK_KEYS travel (taste/layout owned by the theme); machine
# state, histories, outputs and paths never leave the live file.
sync_back() {
    local apply="0" theme="" keys=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply) apply="1"; shift ;;
            --theme) theme="${2:-}"; shift 2 ;;
            --theme=*) theme="${1#--theme=}"; shift ;;
            --keys) keys="${2:-}"; shift 2 ;;
            --keys=*) keys="${1#--keys=}"; shift ;;
            -h|--help) usage; return 0 ;;
            *) echo -e "${RED}Error: Unknown sync-back flag: $1${NC}"; return 2 ;;
        esac
    done
    theme="${theme:-$(get_current_theme)}"
    local theme_file="${THEMES_DIR}/${theme}/dms-settings.json"
    if [[ ! -f "$theme_file" ]]; then
        echo -e "${RED}Error: No dms-settings.json for theme '${theme}'.${NC}"
        return 2
    fi
    python3 - "$theme_file" "${DMS_CONFIG_DIR}/settings.json" "$keys" "$apply" <<'PY'
import difflib
import json
import os
import sys
import tempfile
from pathlib import Path

SYNC_BACK_KEYS = [
    "barConfigs",
    "currentThemeName",
    "currentThemeCategory",
    "customThemeFile",
    "registryThemeVariants",
    "matugenScheme",
    "matugenContrast",
    "widgetBackgroundColor",
    "widgetBackgroundCustomColor",
    "widgetBackgroundCustomStrength",
    "widgetColorMode",
    "controlCenterTileColorMode",
    "buttonColorMode",
]

theme_file = Path(sys.argv[1])
live_file = Path(sys.argv[2])
only = sys.argv[3].split(",") if sys.argv[3] else list(SYNC_BACK_KEYS)
apply = sys.argv[4] == "1"


def load_obj(path):
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text() or "{}")
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


live = load_obj(live_file)
if not live:
    print("sync-back: live settings.json is missing or empty, aborting.", file=sys.stderr)
    sys.exit(2)
theme = load_obj(theme_file)

changes = {}
for key in only:
    if key in live and live.get(key) != theme.get(key):
        changes[key] = live[key]

if not changes:
    print(f"sync-back: {theme_file.parent.name} already in sync ({', '.join(only)}).")
    sys.exit(0)

merged = dict(theme)
merged.update(changes)
new_text = json.dumps(merged, indent=2) + "\n"
old_text = theme_file.read_text() if theme_file.exists() else ""

if old_text:
    try:
        canonical = json.dumps(json.loads(old_text), indent=2) + "\n"
    except json.JSONDecodeError:
        canonical = None
    if canonical is not None and canonical.strip() != old_text.strip():
        print("sync-back: warning: theme file is not canonical indent-2 JSON; diff may include formatting.", file=sys.stderr)

diff = "".join(difflib.unified_diff(
    old_text.splitlines(keepends=True),
    new_text.splitlines(keepends=True),
    fromfile=str(theme_file),
    tofile=str(theme_file) + " (synced)",
))
sys.stdout.write(diff)
if diff and not diff.endswith("\n"):
    print()
if not apply:
    print("sync-back: dry run, re-run with --apply to write.")
    sys.exit(0)

tmp_fd, tmp_path = tempfile.mkstemp(dir=str(theme_file.parent), prefix=".dms-settings.", suffix=".tmp")
try:
    with os.fdopen(tmp_fd, "w") as fh:
        fh.write(new_text)
    os.replace(tmp_path, theme_file)
except BaseException:
    try:
        os.unlink(tmp_path)
    except OSError:
        pass
    raise
print(f"sync-back: wrote {', '.join(changes)} to {theme_file}.")
PY
}

usage() {
    echo -e "${BOLD}Usage: theme-switcher <command> [theme_name]${NC}"
    echo ""
    echo "Commands:"
    echo "  list, -l              List available themes"
    echo "  apply <theme>         Apply a theme (default, windows-10, windows-11)"
    echo "  apply <theme> --reset Apply theme defaults, discarding saved bar/layout tweaks"
    echo "  sync-back             Preview promoting live GUI tweaks (barConfigs) into the active theme (dry run)"
    echo "  sync-back --apply     Write the promoted tweaks into the theme's dms-settings.json"
    echo "  sync-back --theme NAME Sync a non-active theme instead of the current one"
    echo "  sync-back --keys a,b   Sync an explicit key list instead of the curated default"
    echo "  current, status       Show the active theme"
    echo "  help, -h              Show this message"
    echo ""
    echo "Reapplying the active theme keeps live DankMaterialShell settings (bar"
    echo "layout, widgets, etc.) and Start pin/folder layout. Switching away"
    echo "and back restores that theme's last snapshot. Plugin pin state is never"
    echo "replaced by theme defaults once it exists."
    echo ""
    echo "DankMaterialShell color themes (and greeter state) are global: visual"
    echo "themes never overwrite them. Floating mode is also kept across applies."
    echo ""
    echo "Examples:"
    echo "  theme-switcher list"
    echo "  theme-switcher apply windows-10"
    echo "  theme-switcher apply windows-11"
    echo "  theme-switcher apply windows-11 --reset"
    echo "  theme-switcher apply default"
}

parse_reset_flag() {
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--reset" ]]; then
            echo "1"
            return
        fi
    done
    echo "0"
}

case "${1:-}" in
    list|-l)
        list_themes
        ;;
    apply)
        if [[ -z "${2:-}" || "${2}" == --* ]]; then
            echo -e "${RED}Error: Missing theme name.${NC}"
            usage
            exit 1
        fi
        apply_theme "$2" "$(parse_reset_flag "${@:3}")"
        ;;
    current|status)
        echo -e "Active theme: ${BOLD}${GREEN}$(get_current_theme)${NC}"
        ;;
    sync-back)
        sync_back "${@:2}"
        ;;
    help|-h|--help)
        usage
        ;;
    "")
        usage
        ;;
    *)
        if [[ -d "${THEMES_DIR}/$1" ]]; then
            apply_theme "$1" "$(parse_reset_flag "${@:2}")"
        else
            echo -e "${RED}Unknown command or theme: $1${NC}"
            usage
            exit 1
        fi
        ;;
esac
