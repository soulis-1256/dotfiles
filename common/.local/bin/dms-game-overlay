#!/usr/bin/env bash

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
window_tracker="$runtime_dir/dms_overlay_prev_window"

# 1. Check if Control Center is currently open
cc_status=$(dms ipc call control-center status 2>/dev/null)

if [[ "$cc_status" == "visible" ]]; then
    # Close Control Center and restore game focus if tracked
    dms ipc call control-center toggle >/dev/null 2>&1
    prev_addr=$(cat "$window_tracker" 2>/dev/null)
    if [[ -n "$prev_addr" && "$prev_addr" != "null" ]]; then
        hyprctl eval "hl.dispatch(hl.dsp.focus({ window = 'address:$prev_addr' }))" >/dev/null 2>&1
    fi
    rm -f "$window_tracker"
    exit 0
fi

# 2. Check if the active window or workspace is fullscreen
active_info=$(hyprctl activewindow -j 2>/dev/null)
is_fullscreen=$(echo "$active_info" | jq -r 'if . == null or . == {} then "false" else ((.fullscreen != 0 and .fullscreen != false and .fullscreen != null) or (.fullscreenClient != 0 and .fullscreenClient != false and .fullscreenClient != null)) end')

# Also check workspace hasfullscreen as a fallback
if [[ "$is_fullscreen" != "true" ]]; then
    ws_fullscreen=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.hasfullscreen // false')
    if [[ "$ws_fullscreen" == "true" ]]; then
        is_fullscreen="true"
    fi
fi

# 3. Branch based on fullscreen state:
if [[ "$is_fullscreen" == "true" ]]; then
    # Fullscreen mode: Track active game window and open Control Center overlay
    cur_addr=$(echo "$active_info" | jq -r '.address // empty')
    if [[ -n "$cur_addr" ]]; then
        echo "$cur_addr" > "$window_tracker"
    fi

    # Open Control Center overlay
    dms ipc call control-center toggle >/dev/null 2>&1
else
    # Windowed / Desktop mode: Toggle App Launcher (Start Menu)
    dms ipc call launcher toggle >/dev/null 2>&1
fi
